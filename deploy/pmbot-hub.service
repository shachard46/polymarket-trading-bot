[Unit]
Description=pmbot Hub (research and paper-trading loop)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pmbot
Group=pmbot
UMask=0002
WorkingDirectory=/opt/pmbot
EnvironmentFile=/etc/pmbot/pmbot.env
ExecStart=/opt/pmbot/.venv/bin/python main.py
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/pmbot

[Install]
WantedBy=multi-user.target
