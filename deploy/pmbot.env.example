# pmbot environment. Installed to /etc/pmbot/pmbot.env (chmod 600). Plain KEY=VALUE lines,
# no "export", no quotes needed. Lines starting with # are the defaults and are optional.
# Secrets are blank: fill them in. Restart services after editing:
#   sudo systemctl restart pmbot-hub pmbot-bot

# --- Runner mode --------------------------------------------------------------------------
# stub = deterministic fake responses, no model calls, no cost. Verify the install with this.
# Switch to live (and set the provider keys below) only after a stub tick works.
# Values: stub | stub_error | live
PMBOT_MODE=stub

# --- LLM providers (config/models.yaml picks provider and model per role) ----------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OPENROUTER_HTTP_REFERER=
#OPENROUTER_APP_TITLE=
# Comma list of OpenRouter upstream providers never to route to (request body provider.ignore).
# Default Alibaba (it answers some DeepSeek calls with 403 "inappropriate content"); set empty to ignore none.
#OPENROUTER_PROVIDER_IGNORE=Alibaba
# Override the models file, the default model, or one role (format provider:model):
#LLM_MODELS_CONFIG=
#LLM_DEFAULT=
#LLM_ROLE_CONCIERGE=anthropic:claude-sonnet-4-5
# Other roles use LLM_ROLE_<ROLE_NAME_UPPERCASE>=provider:model

# --- LLM call behaviour -------------------------------------------------------------------
#PMBOT_LLM_TIMEOUT=600
#PMBOT_LLM_MAX_ATTEMPTS=3
#PMBOT_LLM_RETRY_BACKOFF=2.0
# Batch API polling (seconds between polls, and the longest wait for a batch).
#PMBOT_LLM_BATCH_POLL_SEC=30
#PMBOT_LLM_BATCH_MAX_WAIT_SEC=1200

# --- Pipeline funnel and research ---------------------------------------------------------
#PMBOT_INGEST_LIMIT=100
#PMBOT_TOP_MARKETS=20
# 0 = unlimited (default); a positive value caps markets triaged / promoted per tick
#PMBOT_GATE_BUDGET=0
#PMBOT_TRIAGE_BUDGET=0
#PMBOT_QUICK_RESEARCH_BUDGET=8
#PMBOT_FULL_RESEARCH_BUDGET=3
#PMBOT_RESEARCH_WORKERS=3
#PMBOT_RESEARCH_TICK_BUDGET_SEC=1800
# aiq | web | ab
#PMBOT_EVIDENCE_SOURCE=ab
# Judge arm for the 1-vs-2-judge cost A/B: ab (stable per-market arm, default) | one | two
#JUDGE_ARM_MODE=ab
# Backend of the "web" evidence arm: brave (Brave Search + page fetch + web_extractor) | gemini (web_searcher).
# Default: brave when BRAVE_API_KEY is set and PMBOT_MODE=live, else gemini. Brave failures fall back to gemini.
#PMBOT_WEB_BACKEND=brave
#BRAVE_API_KEY=
#PMBOT_AUTO_REPLAY=0
#PMBOT_LEDGER_RESOLVE_LIMIT=100
#OVERSEER_MIN_NEW_RESOLVED=30

# --- Vault and backups --------------------------------------------------------------------
# Vault base directory (holds Vault/). Default: the repo root (/opt/pmbot).
#PMBOT_VAULT_PATH=/opt/pmbot
# Optional off-box copy of each backup (needs the aws cli and credentials on the host).
#PMBOT_BACKUP_S3_URI=s3://my-bucket/pmbot/

# --- Polymarket API -----------------------------------------------------------------------
#GAMMA_BASE_URL=
#DATA_API_BASE_URL=
#CLOB_BASE_URL=
#POLYMARKET_API_TIMEOUT_SEC=

# --- Concierge (owner approval of offers and directives) ---------------------------------
# Hub flags: 1 to require owner approval by vote.
#CONCIERGE_APPROVAL=0
#CONCIERGE_APPROVE_DIRECTIVES=0
#CONCIERGE_OFFER_TTL_SEC=14400
#CONCIERGE_DIRECTIVE_TTL_SEC=172800
#CONCIERGE_POLL_SEC=300
# Bot only:
#CONCIERGE_TZ=UTC
#CONCIERGE_QUIET_HOURS=23-07

# --- Discord ------------------------------------------------------------------------------
# Bot (pmbot-bot.service): all three required. See docs/06_concierge.md section 5.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_OWNER_ID=
# Optional webhook used by the Hub for notifications.
DISCORD_WEBHOOK_URL=
